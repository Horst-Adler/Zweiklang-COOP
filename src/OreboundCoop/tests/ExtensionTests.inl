void TestExtensions(){
 namespace e=orebound::extensions;
 for(unsigned mask=0;mask<16;++mask){e::Profile p;for(unsigned i=0;i<4;++i){const bool present=(mask&(1<<i))!=0;e::Evidence proof{present,present,present?e::Definitions()[i].hash:"",present?1:-1};p.modules[i]=e::Detect(static_cast<e::Module>(i),proof);Check(p.modules[i]==(present?e::State::Supported:e::State::Absent),"optional extension absent/supported is detected from evidence");}Check(p.AllowsSession()==(!(mask&11)||bool(mask&4)),"minimal profile valid; comfort library dependencies conditional");}
 for(unsigned i=0;i<4;++i){auto module=static_cast<e::Module>(i);e::Evidence x{true,true,e::Definitions()[i].hash,1};x.hash[0]='X';Check(e::Detect(module,x)==e::State::Unsafe,"modified optional archive rejected");x={false,true,"",1};Check(e::Detect(module,x)==e::State::Unsafe,"renamed loaded extension cannot masquerade as absent");if(i!=2){x={true,false,e::Definitions()[i].hash,1};Check(e::Detect(module,x)==e::State::Unsafe,"archive presence does not prove loaded script");}if(i<2){x={true,true,e::Definitions()[i].hash,2};Check(e::Detect(module,x)==e::State::Unsafe,"unknown quickloot/sprint bridge revision rejected");}}
 for(unsigned i=0;i<128;++i){const bool expected=i==127;Check(e::CoreReady(i&1?4116:4115,i&2?2:1,i&4,i&8,i&16,i&32,i&64)==expected,"core checks independent Ninja/ABI/signature/hash requirements");}
 for(int cmd=-1;cmd<=5;++cmd)for(int value:{-1,0,1,1000000,1000001})Check(e::ValidCommand(cmd,value)==(cmd>=0&&cmd<=4&&(cmd==3?(value>0&&value<=1000000):cmd==4?(value==0||value==1):value==0)),"Ninja dispatch rejects unknown operations and argument bounds");
 auto dir=recovery_test::Temp();std::filesystem::create_directories(dir);const auto path=dir+"\\hash.dat";
 orebound::recovery::AtomicWrite(path,{'a','b','c'});Check(e::FileSha256(path)=="BA7816BF8F01CFEA414140DE5DAE2223B00361A396177A9CB410FF61F20015AD","real Windows SHA256 known answer");
 orebound::recovery::AtomicWrite(path,{});Check(e::FileSha256(path)=="E3B0C44298FC1C149AFBF4C8996FB92427AE41E4649B934CA495991B7852B855","empty dependency file hashes correctly");
 orebound::recovery::AtomicWrite(path,orebound::combat::Bytes(100000,0));Check(e::FileSha256(path)=="9192C25B734FCBADBE32DADC28089C60DB0E39F90CC20CE2E5733F57261ACC0C","SHA256 streaming crosses a complete read buffer without dropping data");
 HANDLE locked=CreateFileA(path.c_str(),GENERIC_READ,0,nullptr,OPEN_EXISTING,FILE_ATTRIBUTE_NORMAL,nullptr);Check(locked!=INVALID_HANDLE_VALUE,"lock isolated hash fixture");bool sharing=false;try{e::FileSha256(path);}catch(const std::exception&){sharing=true;}CloseHandle(locked);Check(sharing,"sharing violation cannot become an absent optional dependency");
 bool missing=false;try{e::FileSha256(path+".missing");}catch(const std::exception&){missing=true;}Check(missing,"unreadable dependency is a failure, never absent");std::filesystem::remove_all(dir);
}
