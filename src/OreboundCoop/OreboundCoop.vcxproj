      <AdditionalIncludeDirectories>$(MSBuildThisFileDirectory)include;$(SdkRoot);$(SdkRoot)ZenGin\Gothic_UserAPI;$(SdkRoot)SDK\Union\v1.0l\Include;$(SdkRoot)SDK\DirectX7\include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
