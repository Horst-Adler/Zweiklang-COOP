  </ItemGroup>
  <ItemGroup Condition="'$(Game)'=='G2NotR'">
    <ClCompile Include="$(SdkRoot)ZenGin\Gothic_II_Addon\ClassDeclarators_G2A.cpp"/>
    <ClCompile Include="$(SdkRoot)ZenGin\Gothic_II_Addon\Globals_G2A.cpp"/>
